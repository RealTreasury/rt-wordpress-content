{
  "name": "rt-wordpress-content",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "test:ejs": "node -e \"console.log('EJS installed:', require('ejs').VERSION)\"",
    "format": "prettier --write .",
    "serve": "npx http-server -p 8080",
    "test:iframe-height": "node scripts/tests/test_webinars_iframe_height.js",
    "test:banner": "node scripts/tests/test_banner_destination.js",
    "test:guide-consent": "node scripts/tests/test_guide_consent_linkify.js",
    "test:publish-css": "bash scripts/tests/test_wp_publish_shared_css.sh",
    "test:publish-post": "python3 scripts/tests/test_wp_publish_post.py",
    "test:carousel": "node scripts/tests/test_homepage_carousel.js",
    "test:css-prune": "node scripts/tests/test_shared_css_prune.js",
    "test:consent-mode": "node scripts/tests/test_consent_mode_defaults.js",
    "test:build-clean": "node scripts/tests/test_build_output_is_committed.js"
  },
  "devDependencies": {
    "ejs": "^3.1.10",
    "http-server": "^14.1.1",
    "prettier": "^3.6.2"
  }
}
